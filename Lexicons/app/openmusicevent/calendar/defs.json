{
  "lexicon": 1,
  "id": "app.openmusicevent.calendar.defs",
  "defs": {
    "calendarEvent": {
      "type": "object",
      "description": "A hydrated calendar event projected by the OpenMusicEvent AppView.",
      "required": [
        "uri",
        "name",
        "locations",
        "links",
        "media",
        "organizer",
        "attendance",
        "source"
      ],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "startsAt": { "type": "string", "format": "datetime" },
        "endsAt": { "type": "string", "format": "datetime" },
        "createdAt": { "type": "string", "format": "datetime" },
        "status": {
          "type": "string",
          "knownValues": [
            "community.lexicon.calendar.event#cancelled",
            "community.lexicon.calendar.event#planned",
            "community.lexicon.calendar.event#postponed",
            "community.lexicon.calendar.event#rescheduled",
            "community.lexicon.calendar.event#scheduled"
          ]
        },
        "mode": {
          "type": "string",
          "knownValues": [
            "community.lexicon.calendar.event#hybrid",
            "community.lexicon.calendar.event#inperson",
            "community.lexicon.calendar.event#virtual"
          ]
        },
        "locations": {
          "type": "array",
          "items": { "type": "ref", "ref": "#location" }
        },
        "links": {
          "type": "array",
          "items": { "type": "ref", "ref": "#link" }
        },
        "media": {
          "type": "array",
          "items": { "type": "ref", "ref": "#media" }
        },
        "organizer": { "type": "ref", "ref": "#organizer" },
        "attendance": { "type": "ref", "ref": "#attendance" },
        "source": { "type": "ref", "ref": "#source" },
        "timeZoneIdentifier": { "type": "string" },
        "event": {
          "type": "unknown",
          "description": "The full OpenMusicEvent event value when this projection hydrates an OME event. Omitted for community calendar events without OME data."
        }
      }
    },
    "page": {
      "type": "object",
      "description": "A cursor-paginated page of hydrated calendar events.",
      "required": ["events"],
      "properties": {
        "cursor": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "type": "ref", "ref": "#calendarEvent" }
        }
      }
    },
    "mapPoint": {
      "type": "object",
      "description": "Compact map metadata for one event with projected coordinates.",
      "required": ["uri", "catalog", "name", "latitude", "longitude"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "catalog": { "type": "string", "format": "nsid" },
        "name": { "type": "string" },
        "startsAt": { "type": "string", "format": "datetime" },
        "endsAt": { "type": "string", "format": "datetime" },
        "latitude": { "type": "float", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "float", "minimum": -180, "maximum": 180 },
        "markerMedia": { "type": "ref", "ref": "#media" }
      }
    },
    "mapCluster": {
      "type": "object",
      "description": "A server-computed group of events represented by one map marker at this zoom.",
      "required": [
        "id",
        "count",
        "latitude",
        "longitude",
        "north",
        "south",
        "east",
        "west",
        "expansionZoom"
      ],
      "properties": {
        "id": { "type": "string" },
        "count": { "type": "integer", "minimum": 2 },
        "latitude": { "type": "float", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "float", "minimum": -180, "maximum": 180 },
        "north": { "type": "float", "minimum": -90, "maximum": 90 },
        "south": { "type": "float", "minimum": -90, "maximum": 90 },
        "east": { "type": "float", "minimum": -180, "maximum": 180 },
        "west": { "type": "float", "minimum": -180, "maximum": 180 },
        "expansionZoom": { "type": "float", "minimum": 0, "maximum": 18 }
      }
    },
    "mapItemPage": {
      "type": "object",
      "description": "The event points and server-computed clusters to render for one viewport.",
      "required": ["events", "clusters", "metrics"],
      "properties": {
        "events": {
          "type": "array",
          "items": { "type": "ref", "ref": "#mapPoint" }
        },
        "clusters": {
          "type": "array",
          "items": { "type": "ref", "ref": "#mapCluster" }
        },
        "metrics": { "type": "ref", "ref": "#mapItemMetrics" }
      }
    },
    "mapItemMetrics": {
      "type": "object",
      "required": [
        "candidateCount",
        "itemCount",
        "databaseDurationMilliseconds",
        "clusteringDurationMilliseconds"
      ],
      "properties": {
        "candidateCount": { "type": "integer", "minimum": 0 },
        "itemCount": { "type": "integer", "minimum": 0 },
        "databaseDurationMilliseconds": { "type": "float", "minimum": 0 },
        "clusteringDurationMilliseconds": { "type": "float", "minimum": 0 }
      }
    },
    "attendance": {
      "type": "object",
      "required": ["going", "interested", "notGoing"],
      "properties": {
        "going": { "type": "integer", "minimum": 0 },
        "interested": { "type": "integer", "minimum": 0 },
        "notGoing": { "type": "integer", "minimum": 0 }
      }
    },
    "link": {
      "type": "object",
      "required": ["uri"],
      "properties": {
        "name": { "type": "string" },
        "uri": { "type": "string", "format": "uri" },
        "source": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "street": { "type": "string" },
        "locality": { "type": "string" },
        "region": { "type": "string" },
        "postalCode": { "type": "string" },
        "country": { "type": "string" },
        "latitude": { "type": "string" },
        "longitude": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "alt": { "type": "string" },
        "role": { "type": "string" },
        "renderKind": {
          "type": "string",
          "knownValues": ["transparent", "fullImage"]
        }
      }
    },
    "organizer": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "format": "did" },
        "handle": { "type": "string", "format": "handle" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "avatarURL": { "type": "string", "format": "uri" }
      }
    },
    "source": {
      "type": "object",
      "required": ["collection"],
      "properties": {
        "collection": { "type": "string", "format": "nsid" },
        "appViewHost": { "type": "string" },
        "sourceRecord": { "type": "ref", "ref": "#sourceRecord" },
        "resolvedArtifact": { "type": "ref", "ref": "#sourceArtifact" },
        "resolvedRepository": { "type": "ref", "ref": "#sourceRepository" }
      }
    },
    "sourceRecord": {
      "type": "object",
      "description": "The canonical organizer source record resolved by the AppView for this event.",
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "type": "string",
          "knownValues": ["tangled"]
        },
        "reference": { "type": "string" },
        "ref": { "type": "string" },
        "createdAt": { "type": "string", "format": "datetime" }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "description": "The immutable source archive published by the AppView. Canonical source identity remains in sourceRecord.",
      "required": ["url", "revision", "checksumSHA256", "byteCount"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string" },
        "checksumSHA256": { "type": "string" },
        "byteCount": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceRepository": {
      "type": "object",
      "description": "The environment-specific repository from which clients fetch source bytes. Canonical source identity remains in sourceRecord.",
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string" },
        "ref": { "type": "string" }
      }
    }
  }
}
