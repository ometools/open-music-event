{
  "lexicon": 1,
  "id": "app.openmusicevent.calendar.getEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a cursor-paginated calendar event catalog from the OpenMusicEvent AppView.",
      "parameters": {
        "type": "params",
        "required": ["catalog"],
        "properties": {
          "catalog": {
            "type": "string",
            "format": "nsid",
            "description": "The event record collection projected by this catalog."
          },
          "cursor": { "type": "string" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "app.openmusicevent.calendar.defs#page"
        }
      },
      "errors": [{ "name": "UnknownCatalog" }]
    }
  }
}
