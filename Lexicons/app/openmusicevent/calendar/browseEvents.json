{
  "lexicon": 1,
  "id": "app.openmusicevent.calendar.browseEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "Browse and search calendar events from one or more AppView catalogs.",
      "parameters": {
        "type": "params",
        "required": ["catalogs"],
        "properties": {
          "catalogs": {
            "type": "array",
            "items": { "type": "string", "format": "nsid" },
            "minLength": 1,
            "maxLength": 2,
            "description": "The event record collections included in this browse query."
          },
          "query": { "type": "string", "maxLength": 256 },
          "north": { "type": "float", "minimum": -90, "maximum": 90 },
          "south": { "type": "float", "minimum": -90, "maximum": 90 },
          "east": { "type": "float", "minimum": -180, "maximum": 180 },
          "west": { "type": "float", "minimum": -180, "maximum": 180 },
          "cursor": { "type": "string" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "app.openmusicevent.calendar.defs#page"
        }
      },
      "errors": [
        { "name": "InvalidBounds" },
        { "name": "InvalidCursor" },
        { "name": "UnknownCatalog" }
      ]
    }
  }
}
