{
  "lexicon": 1,
  "id": "app.openmusicevent.comms.submitPost",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Submit an exact announcement record to the OpenMusicEvent AppView after publishing it to the authenticated account's repository.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "com.atproto.repo.strongRef"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {}
        }
      },
      "errors": [
        { "name": "PostAuthorityMismatch" },
        { "name": "UnsupportedPostCollection" }
      ]
    }
  }
}
