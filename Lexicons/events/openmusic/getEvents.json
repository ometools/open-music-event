{
  "lexicon": 1,
  "id": "events.openmusic.getEvents",
  "defs": {
    "main": {
      "type": "query",
      "description": "Browse indexed canonical music events from the OpenMusicEvent AppView.",
      "parameters": {
        "type": "params",
        "properties": {
          "cursor": { "type": "string" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["events"],
          "properties": {
            "events": {
              "type": "array",
              "items": { "type": "ref", "ref": "events.openmusic.getEvent#event" }
            },
            "cursor": { "type": "string" }
          }
        }
      },
      "errors": [{ "name": "InvalidCursor" }, { "name": "EventIndexUnavailable" }]
    }
  }
}
