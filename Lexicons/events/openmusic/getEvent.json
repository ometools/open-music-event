{
  "lexicon": 1,
  "id": "events.openmusic.getEvent",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read an indexed canonical music event from the OpenMusicEvent AppView.",
      "parameters": {
        "type": "params",
        "required": ["uri"],
        "properties": {
          "uri": { "type": "string", "format": "at-uri" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": { "type": "ref", "ref": "#event" }
      },
      "errors": [{ "name": "EventNotFound" }, { "name": "EventIndexUnavailable" }]
    },
    "event": {
      "type": "object",
      "required": ["uri", "value"],
      "properties": {
        "uri": { "type": "string", "format": "at-uri" },
        "cid": { "type": "string", "format": "cid" },
        "value": { "type": "unknown" }
      }
    }
  }
}
