# This file contains repository-level Fastlane automation that does not need
# App Store Connect, Play Console, signing, or release credentials.

require "json"
require "open3"

opt_out_usage

def repo_root
  File.expand_path("..", __dir__)
end

def compiler_lane
  ENV.fetch(
    "OME_SWIFT_COMPILER_LANE",
    File.expand_path(
      "~/.codex/skills/woodys-swift-workflow/scripts/swift-compiler-lane.sh"
    )
  )
end

def run_compiler_lane(*command)
  UI.user_error!("Swift compiler lane is unavailable at #{compiler_lane}") unless File.executable?(compiler_lane)

  sh(
    compiler_lane,
    "--repo", repo_root,
    "--wait",
    "--priority", "interactive",
    *command
  )
end

def skiplocal
  File.expand_path(
    ENV.fetch(
      "SKIPLOCAL",
      "~/Developer/swift-packages/3rd-party/skip/skipstone"
    )
  )
end

def run_local_skip(*arguments)
  UI.user_error!("SKIPLOCAL is unavailable at #{skiplocal}") unless File.directory?(skiplocal)

  run_compiler_lane(
    "swift-run",
    "--package-path", skiplocal,
    "SkipRunner",
    *arguments
  )
end

def android_harness
  File.join(repo_root, "Scripts", "android-smoke-build.sh")
end

def run_android_harness(*arguments)
  UI.user_error!("Android harness is unavailable at #{android_harness}") unless File.executable?(android_harness)

  with_environment(
    "SWIFT_COMPILER_WAIT" => "1",
    "SWIFT_COMPILER_PRIORITY" => "interactive"
  ) do
    sh(android_harness, *arguments)
  end
end

def with_environment(values)
  previous_values = values.to_h { |key, _value| [key, ENV[key]] }
  values.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
  yield
ensure
  previous_values.each { |key, value| value.nil? ? ENV.delete(key) : ENV[key] = value }
end

def executable_available?(name)
  ENV.fetch("PATH", "")
    .split(File::PATH_SEPARATOR)
    .any? { |directory| File.executable?(File.join(directory, name)) }
end

def booted_ios_device_id
  output, error, status = Open3.capture3("xcrun", "simctl", "list", "devices", "booted", "--json")
  UI.user_error!("Unable to inspect iOS Simulators: #{error}") unless status.success?

  devices = JSON.parse(output).fetch("devices").values.flatten
  device = devices.find { |candidate| candidate["state"] == "Booted" }
  UI.user_error!("No iOS Simulator is booted") unless device

  device.fetch("udid")
end

def maestro_flow(options)
  File.expand_path(options[:flow] || ".maestro/00-launch.yaml", repo_root)
end

def run_maestro(device:, app_id:, platform:, flow:)
  sh(
    "maestro", "--device", device, "test",
    "-e", "APP_ID=#{app_id}",
    "-e", "MAESTRO_PLATFORM=#{platform}",
    flow
  )
end

def verify_maestro_device!(device)
  _output, error, status = Open3.capture3("maestro", "--device", device, "hierarchy")
  UI.user_error!("Maestro cannot connect to #{device}: #{error}") unless status.success?
end

def ios_ui_derived_data_path
  File.join(repo_root, ".build", "fastlane-ios-derived-data")
end

def build_install_launch_ios(device:, app_id:)
  with_environment(
    "SKIP_PLUGIN_DISABLED" => "",
    "SKIP_ACTION" => "none",
    "OME_ANDROID_APP_BUILD" => nil
  ) do
    run_compiler_lane(
      "xcodebuild",
      "-workspace", File.join(repo_root, "Project.xcworkspace"),
      "-scheme", "OpenMusicEvent App",
      "-configuration", "Debug",
      "-destination", "platform=iOS Simulator,id=#{device}",
      "-derivedDataPath", ios_ui_derived_data_path,
      "-skipPackagePluginValidation",
      "-skipMacroValidation",
      "build"
    )
  end

  app_path = File.join(
    ios_ui_derived_data_path,
    "Build", "Products", "Debug-iphonesimulator", "OpenMusicEventApp.app"
  )
  UI.user_error!("iOS app product is missing at #{app_path}") unless File.directory?(app_path)

  sh("xcrun", "simctl", "install", device, app_path)
  sh("xcrun", "simctl", "launch", device, app_id)
end

desc "Run credential-free release readiness checks"
lane :check do
  Dir.chdir(repo_root) do
    run_compiler_lane("swift-run", "ome-release-check")
    run_local_skip("verify")
    run_local_skip("meta", "index")
  end
end

desc "Run the complete Swift package suite on the macOS host"
lane :host_tests do
  run_compiler_lane("swift-test", "--no-parallel")
end

desc "Run OpenMusicEventAppTests on an iOS Simulator"
lane :ios_tests do |options|
  device = options[:device] || ENV["OME_IOS_DEVICE_ID"] || booted_ios_device_id

  with_environment(
    "SKIP_PLUGIN_DISABLED" => "",
    "SKIP_ACTION" => "none",
    "OME_ANDROID_APP_BUILD" => nil
  ) do
    run_compiler_lane(
      "xcodebuild",
      "-workspace", File.join(repo_root, "Project.xcworkspace"),
      "-scheme", "OpenMusicEventAppTests",
      "-destination", "platform=iOS Simulator,id=#{device}",
      "-skipPackagePluginValidation",
      "-skipMacroValidation",
      "-parallel-testing-enabled", "NO",
      "-only-testing:OpenMusicEventAppTests",
      "test"
    )
  end
end

desc "Run OpenMusicEventAppTests in an Android instrumentation APK"
lane :android_tests do |options|
  device = options[:device] || ENV.fetch("OME_ANDROID_DEVICE_ID", "emulator-5554")
  run_android_harness("--serial", device)
  run_android_harness("--tests", "--serial", device)
end

desc "Run the complete non-UI suite for the iOS app and Android"
lane :suite do |options|
  failures = []

  begin
    ios_tests(device: options[:ios_device])
  rescue StandardError => error
    failures << "iOS Simulator suite: #{error.message.lines.first.strip}"
    UI.error(failures.last)
  end

  begin
    android_tests(device: options[:android_device])
  rescue StandardError => error
    failures << "Android instrumentation suite: #{error.message.lines.first.strip}"
    UI.error(failures.last)
  end

  UI.user_error!(failures.join("\n")) unless failures.empty?
end

desc "Start the default headless Android emulator used by local tests"
lane :start_android_emulator do |options|
  name = options[:name] || ENV.fetch("OME_ANDROID_AVD", "Medium_Phone_API_36")
  run_local_skip(
    "android", "emulator", "launch",
    "--name", name,
    "--background",
    "--headless"
  )
end

desc "Verify the local tools and devices required for dual-platform UI tests"
lane :ui_test_preflight do |options|
  UI.user_error!("Maestro is unavailable. Install it with Homebrew before running UI tests.") unless executable_available?("maestro")
  UI.user_error!("Maestro flow does not exist: #{maestro_flow(options)}") unless File.file?(maestro_flow(options))

  ios_device = options[:ios_device] || ENV["OME_IOS_DEVICE_ID"] || booted_ios_device_id
  android_device = options[:android_device] || ENV.fetch("OME_ANDROID_DEVICE_ID", "emulator-5554")

  sh("maestro", "--version")
  verify_maestro_device!(ios_device)
  verify_maestro_device!(android_device)
  UI.success("iOS UI test device: #{ios_device}")
  UI.success("Android UI test device: #{android_device}")
  UI.success("Maestro flow: #{maestro_flow(options)}")
end

desc "Build, install, and run the same Maestro flow on iOS and Android"
lane :ui_tests do |options|
  ui_test_preflight(options)

  ios_device = options[:ios_device] || ENV["OME_IOS_DEVICE_ID"] || booted_ios_device_id
  android_device = options[:android_device] || ENV.fetch("OME_ANDROID_DEVICE_ID", "emulator-5554")
  ios_app_id = options[:ios_app_id] || ENV.fetch("OME_IOS_APP_ID", "app.openmusicevent")
  android_app_id = options[:android_app_id] || ENV.fetch("OME_ANDROID_APP_ID", "fm.woody.openmusicevent")
  flow = maestro_flow(options)

  run_android_harness("--launch", "--serial", android_device)
  build_install_launch_ios(device: ios_device, app_id: ios_app_id)

  run_maestro(
    device: ios_device,
    app_id: ios_app_id,
    platform: "ios",
    flow: flow
  )
  run_maestro(
    device: android_device,
    app_id: android_app_id,
    platform: "android",
    flow: flow
  )
end
