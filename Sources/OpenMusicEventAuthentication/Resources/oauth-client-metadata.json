{
  "client_id": "https://openmusicevent.app/.well-known/oauth-client-metadata.json",
  "client_name": "Open Music Event",
  "application_type": "native",
  "scope": "atproto blob:application/gzip blob:text/x-patch repo:sh.tangled.publicKey?action=create repo:sh.tangled.repo.pull?action=create",
  "response_types": [
    "code"
  ],
  "grant_types": [
    "authorization_code",
    "refresh_token"
  ],
  "redirect_uris": [
    "app.openmusicevent:/oauth/callback"
  ],
  "token_endpoint_auth_method": "none",
  "dpop_bound_access_tokens": true
}
